# Ignore all files starting with . (dotfiles)
.*

# Unignore essential dotfiles (do NOT ignore them)
!.gitignore
!.github
!.gitpod.Dockerfile
!.gitpod.yml
!.welcome
!.devcontainer
!.devcontainer/*
!Dockerfile.render
!.render-buildpacks.json
!render.yml
!.env.example
!.eslintrc
!.htaccess

# Python/Flask ignores
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
*.egg
*.eggs/
*.db  # Local databases (e.g., SQLite)
database.database
database.db
migrations/  # If not committing Alembic migrations
.venv/  # Pipenv virtualenv
env/
venv/
ENV/
*.pot
*.pyx

# Node/React ignores
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/install-state.gz
build/  # React build output (if using Create React App)
dist/  # Alternative build output
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# Logs and temp files
*.log
php_errorlog
.log
diagram.png  # If this is generated

# OS/editor/compiled files
.DS_Store
Thumbs.db
ehthumbs.db
*.sublime-project
*.sublime-workspace
*.komodoproject
*.com
*.class
*.dll
*.exe
*.o
*.so
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.sql
*.sqlite

# Deployment/Prod ignores
.now  # Vercel/Now.sh

# Unignore project essentials (e.g., configs, README)
!README.md
!package.json  # Frontend package.json
!Pipfile  # Pipenv (commit for deps)
!Pipfile.lock  # Usually commit for reproducibility