[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "*"
flask-sqlalchemy = "*"
flask-migrate = "*"
flask-jwt-extended = "==4.6.0"
flask-cors = "*"
flask-admin = "*"
psycopg2-binary = "*"
python-dotenv = "*"
gunicorn = "*"
cloudinary = "*"
werkzeug = "*"
requests = "*"
pyjwt = "==2.9.0"
pytz = "*"

[dev-packages]

[requires]
python_version = "3.13"

[scripts]
start = "python src/app.py"
dev = "python src/app.py"
init = "python -m flask --app src.app:app db init"
migrate = "python -m flask --app src.app:app db migrate"
upgrade = "python -m flask --app src.app:app db upgrade"
reset_db = "python -m flask --app src.app:app db upgrade"