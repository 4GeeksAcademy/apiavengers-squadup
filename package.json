{
  "name": "squadup-gaming-app",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "version": "1.0.0",
  "description": "SquadUp - Find Your Gaming Squad",
  "scripts": {
    "setup-env": "./update-env.sh",
    "dev": "npm run setup-env && vite",
    "start": "npm run setup-env && vite",
    "build": "npm run setup-env && vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "npm run setup-env && vite preview",
    "test:load": "artillery run stress-test.yml",
    "test:load:quick": "artillery quick --count 50 --num 10 http://localhost:3000",
    "test:load:report": "artillery run stress-test.yml --output report.json && artillery report report.json",
    "performance:monitor": "node scripts/performance-check.js"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "artillery": "^2.0.12",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19"
  }
}